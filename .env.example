# ==========================================
# Smart Travel Planner - Environment Configuration
# ==========================================

# Selenium Web Testing Configuration
BASE_URL=http://localhost:3000
TEST_USERNAME=john@example.com
TEST_PASSWORD=your_secure_password_here
HEADLESS=true

# Appium Mobile Android Testing Configuration
ANDROID_APP_PATH=mobile/build/app/outputs/flutter-apk/app-debug.apk
ANDROID_DEVICE_NAME=emulator-5554
APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_PACKAGE=com.smarttravelplanner.mobile
APP_ACTIVITY=com.smarttravelplanner.mobile.MainActivity

# k6 Load Testing Configuration
LOAD_TEST_BASE_URL=http://localhost:5000
LOAD_TEST_PROFILE=smoke
LOAD_TEST_VUS=5
LOAD_TEST_DURATION=30s

# Security Testing Configuration
SECURITY_TEST_TARGET=http://localhost:5000

# Backend & Database Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/smart-travel-planner
MONGO_DB_NAME=smart-travel-planner
JWT_SECRET=your_jwt_secret_token_here
