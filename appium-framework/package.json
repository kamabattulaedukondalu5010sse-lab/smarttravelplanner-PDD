  "description": "Enterprise Appium 2.x E2E Automation Framework for React Native Android apps with Smart AI Testing, Excel reporting, and Winston logging",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json tests/**/*.test.js",
