{
  "name": "selenium-react-e2e-framework",
  "version": "2.0.0",
  "description": "Enterprise Selenium WebDriver E2E Automation Framework for React Applications with Dynamic Route Discovery and Dynamic Form Test Case Generation",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json tests/**/*.test.js",
    "test:e2e": "mocha --config .mocharc.json tests/e2e.test.js",
    "test:dynamic": "mocha --config .mocharc.json tests/dynamicRoutes.test.js",
    "scan:routes": "node -e \"require('./utilities/routeScanner').scanReactRoutes();\""
  },
  "keywords": [
    "selenium",
    "webdriver",
    "react",
    "mocha",
    "chai",
    "exceljs",
    "winston",
    "mochawesome",
    "dynamic-testing",
    "route-scanner"
  ],
  "author": "Senior QA Automation Architect",
  "license": "ISC",
  "dependencies": {
    "selenium-webdriver": "^4.16.0",
    "exceljs": "^4.3.0",
    "winston": "^3.11.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "mochawesome": "^7.1.3",
    "dotenv": "^16.3.1",
    "glob": "^10.3.10"
  }
}
